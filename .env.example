# Existing
GROQ_API_KEY=your_groq_api_key

# Frontend / backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Cookie & JWT secrets — generate real random strings for these
# (e.g. python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_long_random_string
SESSION_SECRET_KEY=change_me_to_a_different_long_random_string

# Set to "true" only when serving over HTTPS in production
COOKIE_SECURE=false

# Google OAuth2 — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BACKEND_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 — create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: {BACKEND_URL}/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
